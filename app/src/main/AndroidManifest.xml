<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="FlappyRush"
        android:theme="@style/Theme.FlappyRush">

        <activity
            android:name=".game.screens.auth.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".game.screens.MenuActivity" android:screenOrientation="portrait" />
        <activity android:name=".game.screens.GameActivity" android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />
        <activity android:name=".game.screens.GameOverActivity" android:screenOrientation="portrait" />
        <activity android:name=".game.screens.profile.ProfileActivity" android:screenOrientation="portrait" />
        <activity android:name=".game.screens.match.MatchmakingActivity" android:screenOrientation="portrait" />
        <activity android:name=".game.screens.match.MultiplayerGameActivity" android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />
        <activity android:name=".game.screens.match.MatchResultActivity" android:screenOrientation="portrait" />

    </application>
</manifest>
